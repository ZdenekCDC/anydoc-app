{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anydoc-app",
  "version": "0.1.2",
  "identifier": "com.cdcargo.anydocapp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "anydoc-app",
        "width": 1100,
        "height": 750,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
